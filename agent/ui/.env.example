# Example configuration file for ROBERT UI
# Copy this to config/.env and fill in your actual API key
# NEVER commit config/.env to git (it's in .gitignore)

# Your OpenAI API key (starting with sk-)
# Get it from: https://platform.openai.com/api-keys
ROBERT_CHAT_API_KEY=sk-your-key-here

# Optional: model override for OpenAI fallback in chat
# If unset, the default model is gpt-4o-mini.
ROBERT_OPENAI_MODEL=gpt-4o-mini

# Optional: response instruction style
# Valid values: REPORT_ONLY (default) or REPORT_WITH_KB
# REPORT_ONLY: Concise explanations focused on the score and evidence
# REPORT_WITH_KB: Include reference material from knowledge base
ROBERT_RESPONSE_STYLE=REPORT_ONLY

# Optional: chat routing mode
# Valid values: HEURISTICS_FIRST (default) or LLM_ONLY
# HEURISTICS_FIRST: Try deterministic FAQ rules first, then LLM fallback
# LLM_ONLY: Always use LLM API (requires ROBERT_CHAT_API_KEY)
ROBERT_CHAT_MODE=HEURISTICS_FIRST
